# Site
NEXT_PUBLIC_SITE_URL=https://nuriyastudio.com
NODE_ENV=production

# Lead generation (WhatsApp number added when ready — digits only, country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email (Resend) — Phase 2
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@nuriyastudio.com
# After domain verification in Resend, e.g. "Nuriya Studio <hello@nuriyastudio.com>"
RESEND_FROM_EMAIL=

# Supabase booking — Phase 2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity CMS — Phase 3
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Webhook URL: POST /api/revalidate?secret=SANITY_REVALIDATE_SECRET

# Analytics — Phase 5 (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Sibling brands
NEXT_PUBLIC_ATHARIQ_URL=https://athariq-production.up.railway.app/
NEXT_PUBLIC_LITTLE_LIGHT_URL=https://little-light-studios.vercel.app/
NEXT_PUBLIC_FOUNDER_URL=https://yaseen-website-production.up.railway.app/
